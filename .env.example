# Local development defaults. Configure production values in Railway → Variables.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
# On Railway, attach a Volume mounted at /app/media. Railway sets
# RAILWAY_VOLUME_MOUNT_PATH automatically; leave MEDIA_ROOT empty there.
MEDIA_ROOT=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=15
# Leave empty on Railway; PUBLIC_BASE_URL is derived from RAILWAY_PUBLIC_DOMAIN.
PUBLIC_BASE_URL=
